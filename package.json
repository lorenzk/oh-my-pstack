{
  "name": "pstack-pi",
  "version": "0.15.36-pi.1",
  "description": "Portable pstack engineering workflows and Agent Skills for Pi, OMP, OpenCode, Claude Code, and Codex.",
  "type": "module",
  "keywords": [
    "pi-package",
    "agent-skills",
    "pstack",
    "coding-agent",
    "developer-workflow",
    "engineering-workflow",
    "code-review",
    "debugging",
    "refactoring",
    "tdd",
    "verification",
    "orchestration",
    "claude-code",
    "codex",
    "opencode",
    "omp",
    "pi",
    "workflow",
    "subagents"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/pstack-router/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "skills",
    "agents",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".claude-plugin",
    ".codex-plugin",
    "upstream.lock.json",
    "assets",
    "!**/node_modules"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs && npm test && npm run typecheck",
    "test": "node --experimental-strip-types --import ./scripts/pi-host-loader.mjs --test scripts/*.test.mjs",
    "test:sync": "node --test scripts/sync-upstream.test.mjs",
    "test:pi": "node scripts/probe-pi.mjs",
    "test:statechart": "npm test --prefix skills/statechart/scripts",
    "typecheck:statechart": "tsc --project skills/statechart/scripts/tsconfig.json",
    "typecheck": "node scripts/typecheck.mjs",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "sync:apply": "node scripts/sync-upstream.mjs --apply"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": ">=0.57.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
